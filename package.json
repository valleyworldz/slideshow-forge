{
  "name": "slideshow-forge",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Convert photo folders into Samsung TV-ready USB slideshows (JPEG folders and H.264 MP4)",
  "main": "dist-electron/main.cjs",
  "bin": {
    "slideshow-forge": "./dist/cli.mjs"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "api": "tsx src/server/index.ts",
    "dev:full": "concurrently -k \"npm run api\" \"npm run dev\"",
    "cli": "tsx src/cli/index.ts",
    "doctor": "tsx src/cli/index.ts doctor",
    "build": "vite build && npm run build:cli",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs --banner:js=\"#!/usr/bin/env node\" --packages=external",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:e2e:full": "cross-env E2E_FULL=1 tsx scripts/e2e.ts",
    "test:production": "npm run lint && npm run test:e2e && npm run elite:approve",
    "test:production:full": "npm run lint && npm run test:e2e:full && cross-env E2E_FULL=1 npm run elite:approve",
    "workspace:scan": "tsx src/cli/index.ts workspace scan",
    "workspace:export": "tsx src/cli/index.ts workspace export --mode both --json",
    "build:electron-preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "build:electron-main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:sharp --packages=external",
    "build:electron": "npm run build:electron-preload && npm run build:electron-main",
    "electron:dev": "npm run build:electron && concurrently -k \"vite --port 3000 --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron dist-electron/main.cjs\"",
    "electron:start": "vite build --mode electron && npm run build:electron && electron .",
    "elite:approve": "tsx scripts/elite-check.ts",
    "elite:approve:full": "cross-env E2E_FULL=1 tsx scripts/elite-check.ts",
    "clean": "node -e \"import('fs').then(fs=>{try{fs.rmSync('dist',{recursive:true})}catch(e){}})\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "commander": "^13.1.0",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.33.5",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.1"
  }
}
